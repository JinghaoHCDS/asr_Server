# Mac-side MCP bridge. Do not put real tokens in this committed example.
ASR_MCP_BASE_URL=http://192.168.31.137:18080
# macOS uses ':' as the path separator. Keep this list as narrow as practical.
ASR_MCP_ALLOWED_ROOTS=/Users/your-name/Downloads:/Users/your-name/Desktop/audio
ASR_MCP_TOKEN=
ASR_MCP_MAX_FILE_MB=512
ASR_MCP_REQUEST_TIMEOUT_SECONDS=3600
